  <Source dwd:design-time-name="1b4da9f6-386e-41b8-a3f0-f96fa0426a08">
    <DataSourceViewID>PSP Interwencje Dwh</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="4348a18b-08ee-4bc5-b4d3-11e369723c33">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].LICZBA_RANNYCH
 AS [Measures].[RANNI DZIECI] +
[Measures].[RANNI INNI] +
[Measures].[RANNI RATOWNICY] +
[Measures].[RANNI STRAZACY], 
FORMAT_STRING = "Standard", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT INTERWENCJE'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].LICZBA_WYPADKOW_SMIERTELNYCH
 AS [Measures].[WYPADKI SMIERTELNE DZIECI] +
[Measures].[WYPADKI SMIERTELNE INNI] +
[Measures].[WYPADKI SMIERTELNE RATOWNICY] +
[Measures].[WYPADKI SMIERTELNE STRAZACY], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT INTERWENCJE'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].MAX_INTERWENCJE
 AS MAX([measures].[LICZBA INTERWENCJI]), 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>