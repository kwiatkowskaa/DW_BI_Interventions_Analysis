                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="WIELKOŚĆ_x0020_INTERWENCJI" msdata:ReadOnly="true" msprop:design-time-name="9fef1232-afb8-4ed5-9e31-2c23afa063c6" msprop:IsLogical="True" msprop:Description="" msprop:DbColumnName="WIELKOŚĆ INTERWENCJI" msprop:ComputedColumnExpression="CASE &#xD;&#xA;  WHEN RODZAJ_NAME = 'P' AND WLK = 'M' THEN 'Mały'&#xD;&#xA;  WHEN RODZAJ_NAME = 'P' AND WLK = 'Ś' THEN 'Średni'&#xD;&#xA;  WHEN RODZAJ_NAME = 'P' AND WLK = 'D' THEN 'Duży'&#xD;&#xA;  WHEN RODZAJ_NAME = 'P' AND WLK = 'BD' THEN 'Bardzo duży'&#xD;&#xA;&#xD;&#xA;  WHEN RODZAJ_NAME = 'MZ' AND WLK = 'M' THEN 'Małe'&#xD;&#xA;  WHEN RODZAJ_NAME = 'MZ' AND WLK = 'L' THEN 'Lokalne'&#xD;&#xA;  WHEN RODZAJ_NAME = 'MZ' AND WLK = 'Ś' THEN 'Średnie'&#xD;&#xA;  WHEN RODZAJ_NAME = 'MZ' AND WLK = 'D' THEN 'Duże'&#xD;&#xA;  WHEN RODZAJ_NAME = 'MZ' AND WLK = 'K' THEN 'Klęska'&#xD;&#xA;&#xD;&#xA;  WHEN RODZAJ_NAME = 'AF' AND WLK = 'Z' THEN 'Złośliwy'&#xD;&#xA;  WHEN RODZAJ_NAME = 'AF' AND WLK = 'DW' THEN 'W dobrej wierze'&#xD;&#xA;  WHEN RODZAJ_NAME = 'AF' AND WLK = 'IW' THEN 'Z instalacji wykrywania'&#xD;&#xA;&#xD;&#xA;  ELSE WLK&#xD;&#xA;END">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="50" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
